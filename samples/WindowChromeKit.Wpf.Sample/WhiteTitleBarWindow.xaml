<chrome:ChromeWindow x:Class="WindowChromeKit.Wpf.Sample.WhiteTitleBarWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:chrome="https://windowchromekit.dev/wpf"
                     Title="白色标题栏示例"
                     AutomationProperties.AutomationId="WhiteTitleBarWindow"
                     Icon="{x:Static chrome:WindowChromeIcons.Windows10}"
                     Width="880"
                     Height="600"
                     MinWidth="460"
                     MinHeight="320"
                     ActiveTitleBarBackground="#FFFFFF"
                     ActiveTitleBarForeground="#202124"
                     InactiveTitleBarBackground="#F1F3F4"
                     InactiveTitleBarForeground="#80868B"
                     CaptionButtonHoverBackground="#E8EAED"
                     CaptionButtonPressedBackground="#DADCE0"
                     CloseButtonHoverBackground="#E81123"
                     CloseButtonPressedBackground="#F1707A"
                     TitleBarBorderBrush="#707070">
    <!-- TitleBarBorderBrush 画的是标题栏顶部那 1 像素边框线：
         Windows 10 的 DWM 不画顶部这一条，需要自己补；Windows 11 上 DWM 会覆盖同一行。 -->
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="24,20" Background="#FFFFFF" BorderBrush="#DADCE0" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#202124" Text="白色标题栏（Chrome 浅色配色）" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="#5F6368"
                           Text="与 samples/WindowChromeKit.Native.Sample、WindowChromeKit.WinForms 同一套原生 frame 模型，下面是人工核对清单。" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16,24,16">
                <TextBlock FontWeight="SemiBold" Foreground="#202124" Text="核对清单" />
                <TextBlock Margin="0,10,0,0" Foreground="#3C4043" TextWrapping="Wrap"
                           Text="1. 阴影与圆角：窗口外侧应有一圈柔和阴影，四角是 Windows 11 的圆角，没有硬边或黑边。" />
                <TextBlock Margin="0,6,0,0" Foreground="#3C4043" TextWrapping="Wrap"
                           Text="2. 阴影里的缩放带：把鼠标移到窗口外侧约 8 像素（视觉上在阴影里）应出现缩放光标；顶部这条带更窄（约 6 像素）。" />
                <TextBlock Margin="0,6,0,0" Foreground="#3C4043" TextWrapping="Wrap"
                           Text="3. 顶边 1 像素线：普通态窗口最上面一行是边框线（Windows 11 由 DWM 画）；最大化后不应出现这条线。" />
                <TextBlock Margin="0,6,0,0" Foreground="#3C4043" TextWrapping="Wrap"
                           Text="4. 标题栏：高 40、图标左边距 12、图标 16、标题从 36 起；按钮 46×39，悬停灰色、关闭悬停红色。" />
                <TextBlock Margin="0,6,0,0" Foreground="#3C4043" TextWrapping="Wrap"
                           Text="5. 最大化：客户区正好铺满工作区，标题栏不出现 1 像素缝隙，最大化按钮变成「还原」字形，悬停弹出 Snap Layouts。" />
                <TextBlock Margin="0,6,0,0" Foreground="#3C4043" TextWrapping="Wrap"
                           Text="6. 拖动与双击：拖标题栏可移动，双击标题栏在最大化/还原之间切换，右击标题栏图标弹出系统菜单。" />

                <Border Margin="0,20,0,0" Padding="14" Background="#F8F9FA" BorderBrush="#DADCE0" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Foreground="#202124" Text="内容区边界（DisplayRectangle 之外就是标题栏）" />
                        <TextBlock Margin="0,8,0,0" Foreground="#5F6368" TextWrapping="Wrap"
                                   Text="下面这块浅灰区域铺满内容区：它的上边紧贴标题栏下边，左右与下边紧贴窗口可见边缘内侧（frame 之外）。" />
                        <Border Margin="0,12,0,0" Height="80" Background="#E8F0FE" BorderBrush="#1A73E8" BorderThickness="1">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#174EA6"
                                       Text="内容区样例：拖动窗口右下角缩放时，这块应始终贴着可见边缘。" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="24,12" Background="#F8F9FA" BorderBrush="#DADCE0" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Foreground="#5F6368"
                           Text="窗口状态：普通态" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Margin="0,0,12,0" Padding="16,8" Click="OnOpenAnotherClicked" Content="再开一个白色窗口" />
                    <Button Padding="16,8" Click="OnToggleMaximizeClicked" Content="最大化 / 还原" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</chrome:ChromeWindow>
