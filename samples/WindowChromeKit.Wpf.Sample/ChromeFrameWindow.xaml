<chrome:ChromeFrame x:Class="WindowChromeKit.Wpf.Sample.ChromeFrameWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:chrome="https://windowchromekit.dev/wpf"
                    Title="ChromeFrame 示例"
                    Width="760"
                    Height="480"
                    MinWidth="460"
                    MinHeight="300"
                    WindowStartupLocation="CenterOwner"
                    Background="#0B1220">
    <chrome:ChromeFrame.Resources>
        <Style x:Key="FrameCaptionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1AFFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2BFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FrameCloseButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource FrameCaptionButtonStyle}">
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DA3B2C" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#AC2418" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </chrome:ChromeFrame.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 这一整条标题栏完全由 Sample 自己实现，ChromeFrame 不提供任何默认标题栏。 -->
        <Border x:Name="TitleBar"
                Grid.Row="0"
                Background="#1E293B"
                BorderBrush="#334155"
                BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#E2E8F0"
                           FontSize="12"
                           Text="ChromeFrame：无内置标题栏，原生缩放 / 阴影 / Snap 由基类提供" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource FrameCaptionButtonStyle}"
                            Content="&#xE921;"
                            Click="OnMinimizeClicked" />
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource FrameCaptionButtonStyle}"
                            Content="&#xE922;"
                            Click="OnMaximizeRestoreClicked" />
                    <Button x:Name="CloseButton"
                            Style="{StaticResource FrameCloseButtonStyle}"
                            Content="&#xE8BB;"
                            Click="OnCloseClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Foreground="#F8FAFC"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Text="ChromeFrame 无标题栏窗口" />
                <TextBlock Margin="0,10,0,0"
                           Foreground="#94A3B8"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Text="继承 ChromeFrame 后，窗口默认没有标题栏。这里演示由 Sample 自己绘制标题栏、自己覆写 HitTestFrame 指定可拖动区域，同时保留基类的 DWM 阴影、八方向缩放和窗口 Snap。" />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,24"
                    Padding="20"
                    Background="#111C2E"
                    BorderBrush="#1E293B"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Foreground="#E2E8F0"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="客户区交互验证" />
                    <TextBox Margin="0,14,0,0"
                             Padding="10,7"
                             Text="这里的输入框、按钮都应该正常工作" />
                    <Button Margin="0,12,0,0"
                            Width="150"
                            Height="34"
                            HorizontalAlignment="Left"
                            Click="OnTestButtonClicked"
                            Content="测试按钮" />
                    <TextBlock x:Name="InteractionStatus"
                               Margin="0,12,0,0"
                               Foreground="#94A3B8"
                               Text="按钮尚未点击" />
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="2"
                       HorizontalAlignment="Right"
                       Foreground="#64748B"
                       FontFamily="Consolas"
                       Text="拖动顶部 40px 可移动窗口，边缘和四角可缩放" />
        </Grid>
    </Grid>
</chrome:ChromeFrame>
