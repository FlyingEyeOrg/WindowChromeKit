<chrome:ChromeWindow x:Class="WindowChromeKit.Wpf.Sample.CustomTitleBarWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:chrome="clr-namespace:WindowChromeKit.Wpf;assembly=WindowChromeKit.Wpf"
                     Title="自定义标题栏示例"
                     Width="820"
                     Height="520"
                     MinWidth="560"
                     MinHeight="360"
                     ActiveTitleBarBackground="#102A43"
                     ActiveTitleBarForeground="#F0F4F8"
                     InactiveTitleBarBackground="#243B53"
                     InactiveTitleBarForeground="#BCCCDC"
                     CaptionButtonHoverBackground="#334E68"
                     CaptionButtonPressedBackground="#486581">
    <chrome:ChromeWindow.TitleBarContent>
        <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="24"
                    Height="24"
                    Margin="8,0"
                    VerticalAlignment="Center"
                    CornerRadius="5"
                    Background="#2CB1BC">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Foreground="White"
                           Text="W" />
            </Border>
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock FontSize="12"
                           FontWeight="SemiBold"
                           Text="WindowChromeKit" />
                <TextBlock FontSize="9"
                           Opacity="0.7"
                           Text="可拖动的自定义标题内容" />
            </StackPanel>
            <TextBox Grid.Column="2"
                     Width="220"
                     Height="27"
                     Margin="18,0,8,0"
                     Padding="8,0"
                     FontSize="12"
                     TextBlock.LineHeight="15"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"
                     BorderThickness="0"
                     Background="#F0F4F8"
                     Foreground="#102A43"
                     Text="标题栏中的可交互输入框"
                     chrome:ChromeWindow.HitTestRole="Client">
                <TextBox.Template>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Height="{Binding Path=(TextBlock.LineHeight), RelativeSource={RelativeSource TemplatedParent}}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>
        </Grid>
    </chrome:ChromeWindow.TitleBarContent>

    <chrome:ChromeWindow.TitleBarActions>
        <Button Width="74"
                Height="27"
                Margin="4,0,8,0"
                Padding="8,2"
                VerticalAlignment="Center"
                Click="OnToggleThemeClicked"
                Content="切换主题" />
    </chrome:ChromeWindow.TitleBarActions>

    <Grid Background="#F5F7FA">
        <StackPanel Width="620"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock FontSize="28"
                       FontWeight="SemiBold"
                       Text="完全可定制标题栏" />
            <TextBlock Margin="0,16,0,0"
                       FontSize="15"
                       Foreground="#52606D"
                       TextWrapping="Wrap"
                       Text="标题、品牌标识、搜索框和操作按钮均由应用提供。空白区域仍可拖动窗口，输入框与按钮保留完整的 WPF 输入行为，系统按钮继续支持 Hover、Pressed 和 Windows Snap Layout。" />
            <Border Margin="0,28,0,0"
                    Padding="18"
                    CornerRadius="8"
                    Background="White"
                    BorderBrush="#D9E2EC"
                    BorderThickness="1">
                <TextBlock FontFamily="Consolas"
                           TextWrapping="Wrap"
                           Text="ChromeWindow.HitTestRole=&quot;Client&quot;&#x0a;TitleBarContent / TitleBarActions&#x0a;CaptionButtonHoverBackground / CaptionButtonPressedBackground" />
            </Border>
        </StackPanel>
    </Grid>
</chrome:ChromeWindow>
