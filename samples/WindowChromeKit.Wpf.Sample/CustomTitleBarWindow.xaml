<chrome:ChromeWindow x:Class="WindowChromeKit.Wpf.Sample.CustomTitleBarWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:chrome="clr-namespace:WindowChromeKit.Wpf;assembly=WindowChromeKit.Wpf"
                     Title="自定义标题栏示例"
                     Width="820"
                     Height="520"
                     MinWidth="720"
                     MinHeight="360"
                     ActiveTitleBarBackground="#102A43"
                     ActiveTitleBarForeground="#F0F4F8"
                     InactiveTitleBarBackground="#243B53"
                     InactiveTitleBarForeground="#BCCCDC"
                     CaptionButtonHoverBackground="#334E68"
                     CaptionButtonPressedBackground="#486581">
    <chrome:ChromeWindow.TitleBarContent>
        <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Width="24"
                   Height="24"
                   Margin="8,0"
                   VerticalAlignment="Center"
                   Source="{Binding Icon, RelativeSource={RelativeSource AncestorType={x:Type chrome:ChromeWindow}}}"
                   Stretch="Uniform" />
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock FontSize="12"
                           FontWeight="SemiBold"
                           Text="WindowChromeKit" />
                <TextBlock FontSize="9"
                           Opacity="0.7"
                           Text="可拖动的自定义标题内容" />
            </StackPanel>
            <TextBox Grid.Column="2"
                     Width="220"
                     Height="20"
                     Margin="18,0,8,0"
                     Padding="8,0"
                     FontSize="12"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"
                     BorderThickness="0"
                     Background="#F0F4F8"
                     Foreground="#102A43"
                     Text="标题栏中的可交互输入框"
                     chrome:ChromeWindow.HitTestRole="Client" />
        </Grid>
    </chrome:ChromeWindow.TitleBarContent>

    <chrome:ChromeWindow.TitleBarActions>
        <Menu Height="35"
              Margin="4,0,8,0"
              VerticalAlignment="Center"
              Background="Transparent"
              chrome:ChromeWindow.HitTestRole="Client">
            <Menu.Resources>
                <Style x:Key="TitleBarMenuItemStyle" TargetType="{x:Type MenuItem}">
                    <Setter Property="Height" Value="35" />
                    <Setter Property="Padding" Value="10,0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="#334E68" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter Property="Background" Value="#486581" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style x:Key="PopupMenuItemStyle" TargetType="{x:Type MenuItem}">
                    <Setter Property="MinWidth" Value="150" />
                    <Setter Property="Padding" Value="12,6" />
                    <Setter Property="Foreground" Value="#102A43" />
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="#D9E2EC" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Menu.Resources>

            <MenuItem Header="文件" Style="{StaticResource TitleBarMenuItemStyle}">
                <MenuItem Header="新建自定义窗口"
                          Style="{StaticResource PopupMenuItemStyle}"
                          Click="OnNewWindowClicked" />
                <Separator />
                <MenuItem Header="关闭"
                          Style="{StaticResource PopupMenuItemStyle}"
                          Click="OnCloseClicked" />
            </MenuItem>
            <MenuItem Header="视图" Style="{StaticResource TitleBarMenuItemStyle}">
                <MenuItem Header="切换标题栏主题"
                          Style="{StaticResource PopupMenuItemStyle}"
                          Click="OnToggleThemeClicked" />
            </MenuItem>
            <MenuItem Header="帮助" Style="{StaticResource TitleBarMenuItemStyle}">
                <MenuItem Header="关于 WindowChromeKit"
                          Style="{StaticResource PopupMenuItemStyle}"
                          Click="OnAboutClicked" />
            </MenuItem>
        </Menu>
    </chrome:ChromeWindow.TitleBarActions>

    <Grid Background="#F5F7FA">
        <StackPanel Width="620"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock FontSize="28"
                       FontWeight="SemiBold"
                       Text="完全可定制标题栏" />
            <TextBlock Margin="0,16,0,0"
                       FontSize="15"
                       Foreground="#52606D"
                       TextWrapping="Wrap"
                       Text="标题、品牌标识、搜索框和操作按钮均由应用提供。空白区域仍可拖动窗口，输入框与按钮保留完整的 WPF 输入行为，系统按钮继续支持 Hover、Pressed 和 Windows Snap Layout。" />
            <Border Margin="0,28,0,0"
                    Padding="18"
                    CornerRadius="8"
                    Background="White"
                    BorderBrush="#D9E2EC"
                    BorderThickness="1">
                <TextBlock FontFamily="Consolas"
                           TextWrapping="Wrap"
                           Text="ChromeWindow.HitTestRole=&quot;Client&quot;&#x0a;TitleBarContent / TitleBarActions&#x0a;CaptionButtonHoverBackground / CaptionButtonPressedBackground" />
            </Border>
        </StackPanel>
    </Grid>
</chrome:ChromeWindow>
