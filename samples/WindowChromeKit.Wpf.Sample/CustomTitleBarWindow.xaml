<chrome:ChromeWindow x:Class="WindowChromeKit.Wpf.Sample.CustomTitleBarWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:chrome="https://windowchromekit.dev/wpf"
                     Title="自定义标题栏示例"
                     Icon="{x:Static chrome:WindowChromeIcons.Windows10}"
                     Width="820"
                     Height="520"
                     MinWidth="720"
                     MinHeight="360"
                     ActiveTitleBarBackground="#102A43"
                     ActiveTitleBarForeground="#F0F4F8"
                     InactiveTitleBarBackground="#243B53"
                     InactiveTitleBarForeground="#BCCCDC"
                     CaptionButtonHoverBackground="#334E68"
                     CaptionButtonPressedBackground="#486581">
    <chrome:ChromeWindow.TitleBarContent>
        <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- 图标区宽 12+16=28、撑满标题栏高度：可交互元素要占满整个标题栏，
                 否则它上方的空白会被顶部缩放带（HTTOP）接管。 -->
            <Border Width="28"
                    Background="Transparent"
                    chrome:ChromeWindow.HitTestRole="SystemMenu">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowTitleBarIcon, RelativeSource={RelativeSource AncestorType={x:Type chrome:ChromeWindow}}}"
                                         Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Image Width="16"
                       Height="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Source="{Binding EffectiveTitleBarIcon, RelativeSource={RelativeSource AncestorType={x:Type chrome:ChromeWindow}}}"
                       Stretch="Uniform" />
            </Border>
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock FontSize="12"
                           FontWeight="SemiBold"
                           Text="WindowChromeKit" />
                <TextBlock FontSize="9"
                           Opacity="0.7"
                           Text="可拖动的自定义标题内容" />
            </StackPanel>
            <TextBox Grid.Column="2"
                     Width="220"
                     Height="20"
                     Margin="18,0,8,0"
                     Padding="8,0"
                     FontSize="12"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"
                     BorderThickness="0"
                     Background="#F0F4F8"
                     Foreground="#102A43"
                     Text="标题栏中的可交互输入框"
                     chrome:ChromeWindow.HitTestRole="Client" />
        </Grid>
    </chrome:ChromeWindow.TitleBarContent>

    <chrome:ChromeWindow.TitleBarActions>
        <Menu Margin="4,0,8,0"
              Background="Transparent"
              Foreground="#F0F4F8"
              chrome:ChromeWindow.HitTestRole="Client">
            <Menu.Resources>
                <Style x:Key="TitleBarMenuItemStyle" TargetType="{x:Type MenuItem}">
                    <Setter Property="Height" Value="35" />
                    <Setter Property="Padding" Value="10,0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="#F0F4F8" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="#334E68" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter Property="Background" Value="#486581" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style x:Key="PopupMenuItemStyle" TargetType="{x:Type MenuItem}">
                    <Setter Property="MinWidth" Value="150" />
                    <Setter Property="Padding" Value="12,6" />
                    <Setter Property="Foreground" Value="#102A43" />
                    <Setter Property="Background" Value="#FFFFFF" />
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="#D9E2EC" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Menu.Resources>

            <MenuItem Header="文件" Style="{StaticResource TitleBarMenuItemStyle}">
                <MenuItem Header="新建自定义窗口"
                          Style="{StaticResource PopupMenuItemStyle}"
                          Click="OnNewWindowClicked" />
                <Separator />
                <MenuItem Header="关闭"
                          Style="{StaticResource PopupMenuItemStyle}"
                          Click="OnCloseClicked" />
            </MenuItem>
            <MenuItem Header="视图" Style="{StaticResource TitleBarMenuItemStyle}">
                <MenuItem Header="切换标题栏主题"
                          Style="{StaticResource PopupMenuItemStyle}"
                          Click="OnToggleThemeClicked" />
                <Separator />
                <MenuItem Header="窗口图标"
                          Style="{StaticResource PopupMenuItemStyle}">
                    <MenuItem Header="WPF 默认图标"
                              Style="{StaticResource PopupMenuItemStyle}"
                              Click="OnUseWpfIconClicked" />
                    <MenuItem Header="Windows 7 图标"
                              Style="{StaticResource PopupMenuItemStyle}"
                              Click="OnUseWindows7IconClicked" />
                    <MenuItem Header="Windows 10 图标"
                              Style="{StaticResource PopupMenuItemStyle}"
                              Click="OnUseWindows10IconClicked" />
                </MenuItem>
                <MenuItem Header="显示标题栏图标"
                          IsCheckable="True"
                          IsChecked="True"
                          Style="{StaticResource PopupMenuItemStyle}"
                          Click="OnShowTitleBarIconClicked" />
            </MenuItem>
            <MenuItem Header="帮助" Style="{StaticResource TitleBarMenuItemStyle}">
                <MenuItem Header="关于 WindowChromeKit"
                          Style="{StaticResource PopupMenuItemStyle}"
                          Click="OnAboutClicked" />
            </MenuItem>
        </Menu>
    </chrome:ChromeWindow.TitleBarActions>

    <Grid Background="#F5F7FA">
        <StackPanel Width="620"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock FontSize="28"
                       FontWeight="SemiBold"
                       Text="完全可定制标题栏" />
            <TextBlock Margin="0,16,0,0"
                       FontSize="15"
                       Foreground="#52606D"
                       TextWrapping="Wrap"
                       Text="标题、品牌标识、搜索框和操作按钮均由应用提供。空白区域仍可拖动窗口，输入框与按钮保留完整的 WPF 输入行为，系统按钮继续支持 Hover、Pressed 和 Windows Snap Layout。" />
            <Border Margin="0,28,0,0"
                    Padding="18"
                    CornerRadius="8"
                    Background="White"
                    BorderBrush="#D9E2EC"
                    BorderThickness="1">
                <TextBlock FontFamily="Consolas"
                           TextWrapping="Wrap"
                           Text="ChromeWindow.HitTestRole=&quot;Client&quot;&#x0a;TitleBarContent / TitleBarActions&#x0a;CaptionButtonHoverBackground / CaptionButtonPressedBackground" />
            </Border>
        </StackPanel>
    </Grid>
</chrome:ChromeWindow>
