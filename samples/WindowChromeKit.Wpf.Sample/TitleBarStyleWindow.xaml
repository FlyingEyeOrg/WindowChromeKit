<chrome:ChromeWindow x:Class="WindowChromeKit.Wpf.Sample.TitleBarStyleWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:chrome="https://windowchromekit.dev/wpf"
                     Title="标题栏样式示例"
                     AutomationProperties.AutomationId="TitleBarStyleWindow"
                     Icon="{x:Static chrome:WindowChromeIcons.Windows10}"
                     Width="880"
                     Height="560"
                     MinWidth="460"
                     MinHeight="320">
    <!-- 不设 TitleBarStyle，用默认的 Chrome；下面三个按钮切换样式，
         几何与配色会一次性套用，内容区保持纯白方便看清标题栏与内容区的分界。 -->
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Margin="24,20,24,0"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Text="标题栏样式：Chrome / VS Code / Windows" />

        <TextBlock Grid.Row="1"
                   Margin="24,10,24,0"
                   LineHeight="20"
                   Foreground="#5F6368"
                   TextWrapping="Wrap"
                   Text="1. 阴影与圆角：窗口外侧应有一圈柔和阴影，四角是 Windows 11 的圆角，没有硬边或黑边。&#x0a;2. 阴影里的缩放带：把鼠标移到窗口外侧约 8 像素（视觉上在阴影里）应出现缩放光标；顶部这条带更窄（约 6 像素）。&#x0a;3. 顶边 1 像素线：普通态窗口最上面一行是边框线（Windows 11 由 DWM 画）；最大化后不应出现这条线。&#x0a;4. 标题栏：图标盒子 22×22、图标 16 在盒内；点图标弹系统菜单，拖标题栏移动，双击最大化/还原。&#x0a;5. 样式切换：下面三个按钮改 TitleBarStyle，几何与配色一次性套用；之后单独改属性以属性为准。&#x0a;6. 最大化：客户区正好铺满工作区，标题栏不出现 1 像素缝隙，最大化按钮变「还原」，悬停弹出 Snap Layouts。" />

        <StackPanel Grid.Row="2"
                    Margin="24,12,24,0"
                    Orientation="Horizontal">
            <Button Margin="0,0,12,0"
                    Padding="16,8"
                    AutomationProperties.AutomationId="ChromeStyleButton"
                    Click="OnChromeStyleClicked"
                    Content="Chrome 样式" />
            <Button Margin="0,0,12,0"
                    Padding="16,8"
                    AutomationProperties.AutomationId="VsCodeStyleButton"
                    Click="OnVsCodeStyleClicked"
                    Content="VS Code 样式" />
            <Button Padding="16,8"
                    AutomationProperties.AutomationId="WindowsStyleButton"
                    Click="OnWindowsStyleClicked"
                    Content="Windows 样式" />
            <TextBlock x:Name="StatusText"
                       Margin="20,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#5F6368" />
        </StackPanel>

        <Border Grid.Row="3"
                Margin="24,16,24,24"
                Background="#E8F0FE"
                BorderBrush="#1A73E8"
                BorderThickness="1">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#174EA6"
                       Text="拖动标题栏、双击最大化、点图标弹系统菜单 —— 三套样式下行为完全一致" />
        </Border>
    </Grid>
</chrome:ChromeWindow>
