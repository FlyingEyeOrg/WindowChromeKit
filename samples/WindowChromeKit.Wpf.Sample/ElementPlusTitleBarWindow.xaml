<chrome:ChromeWindow x:Class="WindowChromeKit.Wpf.Sample.ElementPlusTitleBarWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:chrome="https://windowchromekit.dev/wpf"
                     Title="Element Plus 主色标题栏（Chrome 样式 + 自定义配色）"
                     AutomationProperties.AutomationId="ElementPlusTitleBarWindow"
                     Icon="{x:Static chrome:WindowChromeIcons.Windows10}"
                     Width="900"
                     Height="560"
                     MinWidth="460"
                     MinHeight="320">
    <!-- 基于 Chrome 样式再改配色。配色在后台代码里、**在 TitleBarStyle 之后**赋值：
         TitleBarStyle 会一次性套用整张样式表（几何 + 配色），先改颜色会被它覆盖回去。
         顶边那 1 像素线不用管 —— 它是半透明基色，与标题栏底色混合，自动跟随。 -->
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Margin="24,20,24,0"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#303133"
                   Text="基于 Chrome 样式，只换配色" />

        <TextBlock Grid.Row="1"
                   Margin="24,10,24,0"
                   LineHeight="20"
                   Foreground="#606266"
                   TextWrapping="Wrap"
                   Text="1. 顺序：先在 XAML/代码里设 TitleBarStyle = Chrome，再改 ActiveTitleBarBackground 等属性。&#x0a;   反过来写的话，样式表会把颜色覆盖回默认值。&#x0a;2. 顶边 1 像素线不用改：它是半透明基色，与标题栏底色混合（激活时约 #2F4F70），换任何配色都自动跟随。&#x0a;3. 配色取自 Element Plus 的官方变量（theme-chalk/common/var.scss）：&#x0a;   primary #409EFF、light-3 #79BBFF、light-9 #ECF5FF、dark-2 #337ECC、danger #F56C6C、danger dark-2 #C45656。&#x0a;4. 点标题栏 / 点别的窗口，看激活与失活两套配色，以及按钮的悬停与按下填充。" />

        <StackPanel Grid.Row="2"
                    Margin="24,12,24,0"
                    Orientation="Horizontal">
            <Border Width="190" Height="30" Margin="0,0,10,0" Background="#409EFF">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="White" Text="激活底 #409EFF" />
            </Border>
            <Border Width="190" Height="30" Margin="0,0,10,0" Background="#79BBFF">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#303133" Text="失活底 #79BBFF" />
            </Border>
            <Border Width="190" Height="30" Margin="0,0,10,0" Background="#337ECC">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="White" Text="按钮 hover #337ECC" />
            </Border>
            <Border Width="190" Height="30" Background="#F56C6C">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="White" Text="关闭 hover #F56C6C" />
            </Border>
        </StackPanel>

        <Border Grid.Row="3"
                Margin="24,16,24,24"
                Background="#ECF5FF"
                BorderBrush="#409EFF"
                BorderThickness="1">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#337ECC"
                       Text="自定义配色的标题栏仍然保留全部原生行为：拖动、双击最大化、系统菜单、Snap Layouts" />
        </Border>
    </Grid>
</chrome:ChromeWindow>
