<chrome:ChromeWindow x:Class="WindowChromeKit.Wpf.Sample.ElementPlusTitleBarWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:chrome="https://windowchromekit.dev/wpf"
                     Title="Element Plus 配色 × 三套样式"
                     AutomationProperties.AutomationId="ElementPlusTitleBarWindow"
                     Icon="{x:Static chrome:WindowChromeIcons.Windows7}"
                     Width="960"
                     Height="600"
                     MinWidth="520"
                     MinHeight="360">
    <!-- 三套几何样式（Chrome / VS Code / Windows）各配一款 Element Plus 配色，可逐一切换。
         配色统一由 ElementPlusPalettes.Apply 赋值，它固定按「先样式、后颜色」的顺序 ——
         TitleBarStyle 会一次性套用整张样式表，先改颜色会被它覆盖回去。
         顶边那 1 像素线不用管：它是半透明基色，与底色混合，自动跟随。 -->
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Margin="24,20,24,0"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#303133"
                   Text="Element Plus 配色 × 三套样式" />

        <TextBlock Grid.Row="1"
                   Margin="24,10,24,0"
                   LineHeight="20"
                   Foreground="#606266"
                   TextWrapping="Wrap"
                   Text="1. 下面三个按钮切换「几何样式」，每套都换上一款 Element Plus 配色。&#x0a;2. 顺序：先 TitleBarStyle，再改颜色属性 —— 反过来写样式表会把颜色覆盖回默认值。&#x0a;   本示例统一走 ElementPlusPalettes.Apply，它固定按这个顺序赋值。&#x0a;3. 顶边 1 像素线不用改：它是半透明基色，与标题栏底色混合，换任何配色都自动跟随。&#x0a;4. 配色取自 Element Plus 的官方变量：浅色用 common/var.scss，深色用 dark/var.scss。&#x0a;   注意深色主题的 dark-2 是「向白混」，所以 VS Code 那款的关闭按钮按下会比悬停更亮。" />

        <StackPanel Grid.Row="2"
                    Margin="24,12,24,0"
                    Orientation="Horizontal">
            <Button Margin="0,0,12,0"
                    Padding="16,8"
                    AutomationProperties.AutomationId="ElementPlusChromeButton"
                    Click="OnChromeClicked"
                    Content="Chrome 样式 × Element Plus 主色" />
            <Button Margin="0,0,12,0"
                    Padding="16,8"
                    AutomationProperties.AutomationId="ElementPlusVsCodeButton"
                    Click="OnVsCodeClicked"
                    Content="VS Code 样式 × Element Plus 深色" />
            <Button Padding="16,8"
                    AutomationProperties.AutomationId="ElementPlusWindowsButton"
                    Click="OnWindowsClicked"
                    Content="Windows 样式 × Element Plus 中性" />
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Margin="24,12,24,0">
            <TextBlock x:Name="StatusText"
                       Margin="0,0,0,8"
                       Foreground="#606266"
                       TextWrapping="Wrap" />
            <WrapPanel x:Name="Swatches" />
        </StackPanel>

        <Border Grid.Row="4"
                Margin="24,16,24,24"
                Background="#ECF5FF"
                BorderBrush="#409EFF"
                BorderThickness="1">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#337ECC"
                       Text="自定义配色的标题栏仍然保留全部原生行为：拖动、双击最大化、系统菜单、Snap Layouts" />
        </Border>
    </Grid>
</chrome:ChromeWindow>
