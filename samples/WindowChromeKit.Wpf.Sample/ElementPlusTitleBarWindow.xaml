<chrome:ChromeWindow x:Class="WindowChromeKit.Wpf.Sample.ElementPlusTitleBarWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:chrome="https://windowchromekit.dev/wpf"
                     Title="Element Plus 配色 × 三套样式"
                     AutomationProperties.AutomationId="ElementPlusTitleBarWindow"
                     Icon="{x:Static chrome:WindowChromeIcons.Windows7}"
                     Width="960"
                     Height="600"
                     MinWidth="520"
                     MinHeight="360">
    <!-- 三套几何样式（Chrome / VS Code / Windows）各配一款 Element Plus 配色，可逐一切换。
         配色统一由 ElementPlusPalettes.Apply 赋值，它固定按「先样式、后颜色」的顺序 ——
         TitleBarStyle 会一次性套用整张样式表，先改颜色会被它覆盖回去。
         顶边那 1 像素线不用管：它是半透明基色，与底色混合，自动跟随。 -->
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Margin="24,20,24,0"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#303133"
                   Text="Element Plus 配色 × 三套样式" />

        <TextBlock Grid.Row="1"
                   Margin="24,10,24,0"
                   LineHeight="20"
                   Foreground="#606266"
                   TextWrapping="Wrap"
                   Text="1. 标题栏是两个正交的轴：TitleBarStyle 管几何（标题栏高、按钮尺寸、图标位置），&#x0a;   TitleBarPalette 管配色。下面三个按钮同时切换两者（几何 + Element Plus 配色）。&#x0a;2. 两者谁后赋值都成立，不会互相覆盖；之后单独改颜色属性也以属性为准。&#x0a;3. 色板来自库里（ElementPlusTheme），数值取自 Element Plus 的官方变量：&#x0a;   浅色用 common/var.scss，深色用 dark/var.scss。&#x0a;4. 下面的色块读的是窗口上实际生效的颜色，不是另抄的一份表。" />

        <StackPanel Grid.Row="2"
                    Margin="24,12,24,0"
                    Orientation="Horizontal">
            <Button Margin="0,0,12,0"
                    Padding="16,8"
                    AutomationProperties.AutomationId="ElementPlusChromeButton"
                    Click="OnChromeClicked"
                    Content="Chrome 样式 × Element Plus 主色" />
            <Button Margin="0,0,12,0"
                    Padding="16,8"
                    AutomationProperties.AutomationId="ElementPlusVsCodeButton"
                    Click="OnVsCodeClicked"
                    Content="VS Code 样式 × Element Plus 深色" />
            <Button Padding="16,8"
                    AutomationProperties.AutomationId="ElementPlusWindowsButton"
                    Click="OnWindowsClicked"
                    Content="Windows 样式 × Element Plus 中性" />
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Margin="24,12,24,0">
            <TextBlock x:Name="StatusText"
                       Margin="0,0,0,8"
                       Foreground="#606266"
                       TextWrapping="Wrap" />
            <WrapPanel x:Name="Swatches" />
        </StackPanel>

        <Border Grid.Row="4"
                Margin="24,16,24,24"
                Background="#ECF5FF"
                BorderBrush="#409EFF"
                BorderThickness="1">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#337ECC"
                       Text="自定义配色的标题栏仍然保留全部原生行为：拖动、双击最大化、系统菜单、Snap Layouts" />
        </Border>
    </Grid>
</chrome:ChromeWindow>
