<chrome:ChromeWindow x:Class="WindowChromeKit.Wpf.Sample.ElementPlusTitleBarWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:chrome="https://windowchromekit.dev/wpf"
                     Title="Element Plus 配色 × 三套样式"
                     AutomationProperties.AutomationId="ElementPlusTitleBarWindow"
                     Icon="{x:Static chrome:WindowChromeIcons.Windows7}"
                     Width="960"
                     Height="600"
                     MinWidth="520"
                     MinHeight="360">
    <!-- 三套几何样式（Chrome / VS Code / Windows）各配一款 Element Plus 配色，可逐一切换。
         配色统一由 ElementPlusPalettes.Apply 赋值，它固定按「先样式、后颜色」的顺序 ——
         TitleBarStyle 会一次性套用整张样式表，先改颜色会被它覆盖回去。
         顶边那 1 像素线不用管：它是半透明基色，与底色混合，自动跟随。 -->
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Margin="24,20,24,0"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#303133"
                   Text="Element Plus 配色 × 三套样式" />

        <TextBlock Grid.Row="1"
                   Margin="24,10,24,0"
                   LineHeight="20"
                   Foreground="#606266"
                   TextWrapping="Wrap"
                   Text="1. 上行按钮换「骨架」（TitleBarStyle：标题栏高、按钮尺寸、图标位置），&#x0a;   下行按钮换「配色」（TitleBarPalette）。两行互不干扰，3×3 共 9 种组合。&#x0a;2. 两者谁后赋值都成立，不会互相覆盖；之后单独改颜色属性也以属性为准。&#x0a;3. 三套配色取自 Element Plus 的官方变量（common/var.scss 与 dark/var.scss）：&#x0a;   主色 = primary 当底；深色 = 它的深色主题；中性 = 浅色底只在按钮上出主色。&#x0a;4. 下面的色块读的是窗口上实际生效的颜色，不是另抄的一份表。" />

        <StackPanel Grid.Row="2"
                    Margin="24,12,24,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="StyleChromeButton"
                        Margin="0,0,8,0"
                        Padding="14,6"
                        AutomationProperties.AutomationId="StyleChromeButton"
                        Content="骨架：Chrome" />
                <Button x:Name="StyleVsCodeButton"
                        Margin="0,0,8,0"
                        Padding="14,6"
                        AutomationProperties.AutomationId="StyleVsCodeButton"
                        Content="骨架：VS Code" />
                <Button x:Name="StyleWindowsButton"
                        Padding="14,6"
                        AutomationProperties.AutomationId="StyleWindowsButton"
                        Content="骨架：Windows" />
            </StackPanel>
            <StackPanel Margin="0,8,0,0"
                        Orientation="Horizontal">
                <Button x:Name="PalettePrimaryButton"
                        Margin="0,0,8,0"
                        Padding="14,6"
                        AutomationProperties.AutomationId="PalettePrimaryButton"
                        Content="配色：主色" />
                <Button x:Name="PaletteDarkButton"
                        Margin="0,0,8,0"
                        Padding="14,6"
                        AutomationProperties.AutomationId="PaletteDarkButton"
                        Content="配色：深色" />
                <Button x:Name="PaletteNeutralButton"
                        Padding="14,6"
                        AutomationProperties.AutomationId="PaletteNeutralButton"
                        Content="配色：中性" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Margin="24,12,24,0">
            <TextBlock x:Name="StatusText"
                       Margin="0,0,0,8"
                       Foreground="#606266"
                       TextWrapping="Wrap" />
            <WrapPanel x:Name="Swatches" />
        </StackPanel>

        <Border Grid.Row="4"
                Margin="24,16,24,24"
                Background="#ECF5FF"
                BorderBrush="#409EFF"
                BorderThickness="1">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#337ECC"
                       Text="自定义配色的标题栏仍然保留全部原生行为：拖动、双击最大化、系统菜单、Snap Layouts" />
        </Border>
    </Grid>
</chrome:ChromeWindow>
