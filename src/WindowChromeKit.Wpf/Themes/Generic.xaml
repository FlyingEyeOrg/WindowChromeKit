<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WindowChromeKit.Wpf">
    <Style TargetType="{x:Type local:ChromeWindow}">
        <Setter Property="Background" Value="White" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ChromeWindow}">
                    <Grid Background="{TemplateBinding Background}"
                          ClipToBounds="True"
                          SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border x:Name="PART_TitleBar"
                                Grid.Row="0"
                                Height="{TemplateBinding TitleBarHeight}"
                                ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" ClipToBounds="True">
                                    <StackPanel Orientation="Horizontal">
                                        <Image x:Name="PART_Icon"
                                               Width="16"
                                               Height="16"
                                               Margin="10,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Source="{TemplateBinding Icon}"
                                               Stretch="Uniform" />
                                        <TextBlock x:Name="PART_Title"
                                                   Margin="0"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left"
                                                   FontFamily="Segoe UI"
                                                   FontSize="12"
                                                   IsHitTestVisible="False"
                                                   Text="{TemplateBinding Title}" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Border x:Name="PART_MinimizeButton"
                                            Width="{TemplateBinding CaptionButtonWidth}"
                                            Height="{TemplateBinding TitleBarHeight}"
                                            IsHitTestVisible="False">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10"
                                                   Text="&#xE921;" />
                                    </Border>
                                    <Border x:Name="PART_MaximizeButton"
                                            Width="{TemplateBinding CaptionButtonWidth}"
                                            Height="{TemplateBinding TitleBarHeight}"
                                            IsHitTestVisible="False">
                                        <TextBlock x:Name="PART_MaximizeGlyph"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10"
                                                   Text="&#xE922;" />
                                    </Border>
                                    <Border x:Name="PART_CloseButton"
                                            Width="{TemplateBinding CaptionButtonWidth}"
                                            Height="{TemplateBinding TitleBarHeight}"
                                            IsHitTestVisible="False">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10"
                                                   Text="&#xE8BB;" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <AdornerDecorator Grid.Row="1">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </AdornerDecorator>

                        <ResizeGrip x:Name="PART_ResizeGrip"
                                    Grid.Row="1"
                                    Width="16"
                                    Height="16"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ResizeMode" Value="CanResizeWithGrip">
                            <Setter TargetName="PART_ResizeGrip" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="PART_MaximizeGlyph" Property="Text" Value="&#xE923;" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
