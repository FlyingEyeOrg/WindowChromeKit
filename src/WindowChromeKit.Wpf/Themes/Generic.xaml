<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WindowChromeKit.Wpf"
    xmlns:shell="clr-namespace:System.Windows;assembly=PresentationFramework">
    <Style x:Key="DefaultCaptionButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- 最大化时客户区顶到工作区，按钮与 Chrome 一样贴到第 0 行 -->
            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                <Setter Property="VerticalAlignment" Value="Top" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type local:ChromeWindow}">
        <Setter Property="Background" Value="White" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ChromeWindow}">
                    <Grid Background="{TemplateBinding Background}"
                          ClipToBounds="True"
                          SnapsToDevicePixels="True">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ActivationStates">
                                <VisualState x:Name="Active" />
                                <VisualState x:Name="Inactive" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="WindowStates">
                                <VisualState x:Name="NormalWindow" />
                                <VisualState x:Name="Minimized" />
                                <VisualState x:Name="Maximized" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="MinimizeButtonStates">
                                <VisualState x:Name="MinimizeNormal" />
                                <VisualState x:Name="MinimizePointerOver" />
                                <VisualState x:Name="MinimizePressed" />
                                <VisualState x:Name="MinimizeDisabled" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="MaximizeButtonStates">
                                <VisualState x:Name="MaximizeNormal" />
                                <VisualState x:Name="MaximizePointerOver" />
                                <VisualState x:Name="MaximizePressed" />
                                <VisualState x:Name="MaximizeDisabled" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CloseButtonStates">
                                <VisualState x:Name="CloseNormal" />
                                <VisualState x:Name="ClosePointerOver" />
                                <VisualState x:Name="ClosePressed" />
                                <VisualState x:Name="CloseDisabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border x:Name="PART_TitleBar"
                                Grid.Row="0"
                                Height="{TemplateBinding TitleBarHeight}"
                                Background="{TemplateBinding InactiveTitleBarBackground}"
                                BorderBrush="{TemplateBinding InactiveTitleBarBorderBrush}"
                                BorderThickness="{TemplateBinding TitleBarBorderThickness}"
                                ClipToBounds="True"
                                TextElement.Foreground="{TemplateBinding InactiveTitleBarForeground}"
                                local:ChromeWindow.HitTestRole="Caption">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" MinWidth="0" Background="Transparent">
                                    <StackPanel x:Name="PART_DefaultTitleContent"
                                                Orientation="Horizontal"
                                                Visibility="Collapsed">
                                        <!-- 图标：16px、左边距 12px（图标固定在 12..27），标题文字从 36px 起 -->
                                        <Border x:Name="PART_SystemMenu"
                                                Width="Auto"
                                                Background="Transparent">
                                            <!-- 系统菜单命中盒子：与原生标题栏同形状 —— SM_CXSMSIZE × SM_CYSMSIZE
                                                 （96dpi 下 22×22 的正方形、竖向居中），中心对准图标；
                                                 盒子之外的标题栏（含图标左边那点空白）仍然可拖动 -->
                                            <Border Width="22"
                                                    Height="22"
                                                    Margin="{TemplateBinding CaptionIconBoxMargin}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Background="Transparent"
                                                    local:ChromeWindow.HitTestRole="SystemMenu">
                                                <Image Width="16"
                                                       Height="16"
                                                       Margin="3,0,0,0"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       Source="{TemplateBinding EffectiveTitleBarIcon}"
                                                       Stretch="Uniform" />
                                            </Border>
                                        </Border>
                                        <TextBlock Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="{TemplateBinding Title}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <ContentPresenter x:Name="PART_TitleBarContentPresenter"
                                                      Content="{TemplateBinding TitleBarContent}"
                                                      ContentTemplate="{TemplateBinding TitleBarContentTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding TitleBarContentTemplateSelector}"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch" />
                                </Grid>

                                <ContentPresenter x:Name="PART_TitleBarActionsPresenter"
                                                  Grid.Column="1"
                                                  Content="{TemplateBinding TitleBarActions}"
                                                  ContentTemplate="{TemplateBinding TitleBarActionsTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding TitleBarActionsTemplateSelector}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Stretch"
                                                  local:ChromeWindow.HitTestRole="Client" />

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button x:Name="PART_MinimizeButton"
                                            Width="{TemplateBinding CaptionButtonWidth}"
                                            Height="{TemplateBinding CaptionButtonHeight}"
                                            Style="{StaticResource DefaultCaptionButtonStyle}"
                                            Foreground="{Binding Path=(TextElement.Foreground), ElementName=PART_TitleBar}"
                                            Command="{x:Static shell:SystemCommands.MinimizeWindowCommand}"
                                            CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                            AutomationProperties.Name="最小化"
                                            local:ChromeWindow.HitTestRole="MinimizeButton">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE921;" />
                                    </Button>
                                    <Button x:Name="PART_MaximizeButton"
                                            Width="{TemplateBinding CaptionButtonWidth}"
                                            Height="{TemplateBinding CaptionButtonHeight}"
                                            Style="{StaticResource DefaultCaptionButtonStyle}"
                                            Foreground="{Binding Path=(TextElement.Foreground), ElementName=PART_TitleBar}"
                                            Command="{x:Static shell:SystemCommands.MaximizeWindowCommand}"
                                            CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                            AutomationProperties.Name="最大化或还原"
                                            local:ChromeWindow.HitTestRole="MaximizeButton">
                                        <TextBlock x:Name="PART_MaximizeGlyph"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10"
                                                   Text="&#xE922;" />
                                    </Button>
                                    <Button x:Name="PART_CloseButton"
                                            Width="{TemplateBinding CaptionButtonWidth}"
                                            Height="{TemplateBinding CaptionButtonHeight}"
                                            Style="{StaticResource DefaultCaptionButtonStyle}"
                                            Foreground="{Binding Path=(TextElement.Foreground), ElementName=PART_TitleBar}"
                                            Command="{x:Static shell:SystemCommands.CloseWindowCommand}"
                                            CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                            AutomationProperties.Name="关闭"
                                            local:ChromeWindow.HitTestRole="CloseButton">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE8BB;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <AdornerDecorator Grid.Row="1">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </AdornerDecorator>

                        <ResizeGrip x:Name="PART_ResizeGrip"
                                    Grid.Row="1"
                                    Width="16"
                                    Height="16"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Visibility="Collapsed" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="True">
                            <Setter TargetName="PART_TitleBar"
                                    Property="BorderBrush"
                                    Value="{Binding TitleBarBorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="PART_TitleBar" Property="Background" Value="{Binding ActiveTitleBarBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="PART_TitleBar" Property="TextElement.Foreground" Value="{Binding ActiveTitleBarForeground, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="TitleBarContent" Value="{x:Null}">
                            <Setter TargetName="PART_DefaultTitleContent" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_TitleBarContentPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowTitleBarIcon" Value="False">
                            <Setter TargetName="PART_SystemMenu" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="PART_MinimizeButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_MaximizeButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="CanResizeWithGrip">
                            <Setter TargetName="PART_ResizeGrip" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="PART_MaximizeGlyph" Property="Text" Value="&#xE923;" />
                            <Setter TargetName="PART_MaximizeButton" Property="Command" Value="{x:Static shell:SystemCommands.RestoreWindowCommand}" />
                        </Trigger>
                        <Trigger Property="HoveredChromeRole" Value="MinimizeButton">
                            <Setter TargetName="PART_MinimizeButton" Property="Background" Value="{Binding CaptionButtonHoverBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="HoveredChromeRole" Value="MaximizeButton">
                            <Setter TargetName="PART_MaximizeButton" Property="Background" Value="{Binding CaptionButtonHoverBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="HoveredChromeRole" Value="CloseButton">
                            <Setter TargetName="PART_CloseButton" Property="Background" Value="{Binding CloseButtonHoverBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="PART_CloseButton" Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="PressedChromeRole" Value="MinimizeButton">
                            <Setter TargetName="PART_MinimizeButton" Property="Background" Value="{Binding CaptionButtonPressedBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="PressedChromeRole" Value="MaximizeButton">
                            <Setter TargetName="PART_MaximizeButton" Property="Background" Value="{Binding CaptionButtonPressedBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="PressedChromeRole" Value="CloseButton">
                            <Setter TargetName="PART_CloseButton" Property="Background" Value="{Binding CloseButtonPressedBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="PART_CloseButton" Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="CanMinimize">
                            <Setter TargetName="PART_MaximizeButton" Property="IsEnabled" Value="False" />
                            <Setter TargetName="PART_MaximizeButton" Property="Opacity" Value="{Binding CaptionButtonDisabledOpacity, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="PART_MaximizeButton" Property="Background" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
